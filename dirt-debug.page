<script>
$(function() {
    let socket;

    function connect() {
      socket = new WebSocket(`ws://${window.location.hostname}:41820?clientId=dirt-debug.page`);

      socket.onopen = function() {
        console.log("Debug Tab: WebSocket connection established.");
      };

      socket.onmessage = function(event) {
        console.log("Debug Tab: Message from server: ", event.data);
        const parsedMessage = JSON.parse(event.data);
        const { action, data } = parsedMessage;

        if (action === 'dbStatus' && data.systemInfo) {
          const sys = data.systemInfo;
          $('#running-kernel-version').text(sys.running.version);
          $('#running-unraid-version').text('Unraid Version: ' + sys.running.unraidVersion);
          $('#running-ebpf-badge')
            .text(sys.running.ebpfEnabled ? 'eBPF ENABLED' : 'eBPF DISABLED')
            .removeClass('status-enabled status-disabled')
            .addClass(sys.running.ebpfEnabled ? 'status-enabled' : 'status-disabled');

          $('#boot-kernel-version').text(sys.boot.version);
          $('#boot-unraid-version').text('Unraid Version: ' + sys.boot.unraidVersion);
          $('#boot-ebpf-badge')
            .text(sys.boot.ebpfEnabled ? 'eBPF ENABLED' : 'eBPF DISABLED')
            .removeClass('status-enabled status-disabled')
            .addClass(sys.boot.ebpfEnabled ? 'status-enabled' : 'status-disabled');
        } else if (action === 'scriptOutput') {
          const $output = $('#script-output');
          $output.append(data.text);
          $output.scrollTop($output[0].scrollHeight);
        } else if (action === 'scriptComplete') {
          $('#script-output').append(`\n--- Process finished with code ${data.code} ---\n`);
          $('#install-ebpf-btn').prop('disabled', false).text('Update to eBPF-enabled Kernel');
        } else if (action === 'wipeComplete') {
          alert('Redis database has been wiped.');
        }
      };

      socket.onclose = function(event) {
        setTimeout(connect, 1000);
      };

      socket.onerror = function(error) {
        socket.close();
      };
    }

    function dirtySock(action, data) {
        const message = {
          clientId: "dirt-debug.page",
          action: action,
          data: data
        };
        if (socket && socket.readyState === WebSocket.OPEN) {
          socket.send(JSON.stringify(message));
        }
    }

    connect();

    // --- Service Control Logic ---
    function updateServiceStatuses() {
        $.getJSON('?get_service_status=1', function(data) {
            Object.keys(data).forEach(service => {
                const isRunning = data[service];
                const $badge = $(`#${service}-status-badge`);
                const $startBtn = $(`#${service}-start-btn`);
                const $stopBtn = $(`#${service}-stop-btn`);

                $badge.text(isRunning ? 'RUNNING' : 'STOPPED')
                      .removeClass('status-enabled status-disabled')
                      .addClass(isRunning ? 'status-enabled' : 'status-disabled');

                $startBtn.prop('disabled', isRunning);
                $stopBtn.prop('disabled', !isRunning);
            });
        });
    }

    function handleServiceAction(service, action) {
        const $startBtn = $(`#${service}-start-btn`);
        const $stopBtn = $(`#${service}-stop-btn`);

        $startBtn.prop('disabled', true);
        $stopBtn.prop('disabled', true);

        $.post('', {
            service_action: 1,
            service: service,
            action: action
        }, function(response) {
            if (!response.success) {
                alert(`Error ${action}ing ${service}: ` + response.output.join('\n'));
            }
            updateServiceStatuses();
        }, 'json');
    }

    $('#valkey-start-btn').on('click', () => handleServiceAction('valkey', 'start'));
    $('#valkey-stop-btn').on('click', () => handleServiceAction('valkey', 'stop'));
    $('#nodejs-start-btn').on('click', () => handleServiceAction('nodejs', 'start'));
    $('#nodejs-stop-btn').on('click', () => handleServiceAction('nodejs', 'stop'));
    $('#dirt-start-btn').on('click', () => handleServiceAction('dirt', 'start'));
    $('#dirt-stop-btn').on('click', () => handleServiceAction('dirt', 'stop'));

    // Initial status check and periodic refresh
    updateServiceStatuses();
    setInterval(updateServiceStatuses, 5000);

    // --- Event Listeners ---
    $('#by-size-btn').on('click', function() {
        const size = $('#size-input').val();
        if (size) dirtySock('debugFindFilesBySize', parseInt(size, 10));
    });

    $('#by-path-btn').on('click', function() {
        const path = $('#path-input').val();
        if (path) dirtySock('debugFindFileByPath', path);
    });

    $('#multiple-paths-btn').on('click', function() {
        dirtySock('debugFindFilesWithMultiplePaths', null);
    });

    $('#non-unique-hash-btn').on('click', function() {
        dirtySock('debugFindFilesWithNonUniqueHashes', null);
    });

    $('#save-db-snapshot-btn').on('click', function() {
        dirtySock('saveDbSnapshot', null);
    });

    $('#create-file-btn').on('click', function() {
        const path = $('#create-path-input').val();
        const size = $('#create-size-input').val();
        if (path && size) {
            dirtySock('debugCreateFileAndUpsert', { path: path, size: parseInt(size, 10) });
        }
    });

    $('#upsert-file-btn').on('click', function() {
        const path = $('#upsert-path-input').val();
        if (path) dirtySock('debugUpsertExistingFile', { path: path });
    });

    $('#wipe-db-btn').on('click', function() {
        if (confirm("This will permanently delete ALL data in the Redis database. Are you sure?")) {
            dirtySock('wipeDatabase', null);
        }
    });

    $('#install-ebpf-btn').on('click', function() {
        if (confirm("This will download and install a new kernel to your flash drive. A reboot will be required. Are you sure?")) {
            $(this).prop('disabled', true).text('Updating Kernel...');
            $('#script-output').text('');
            $('#script-output-container').show();
            dirtySock('installEbpfKernel', null);
        }
    });
});
</script>
